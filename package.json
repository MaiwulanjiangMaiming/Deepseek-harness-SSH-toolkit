{
  "name": "dsh-ssh-toolkit",
  "version": "1.4.1",
  "description": "SSH remote workspaces for DeepSeek Harness — run sessions on a remote machine.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./tools": "./tools/index.js",
    "./src/*": "./src/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "tools",
    "src",
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiwulanjiangMaiming/Deepseek-harness-SSH-toolkit.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-fs": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-shell": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-storage-domain": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.5"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "ssh2": "^1.17.0",
    "zod": "^4.4.3"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "selfcheck": "node scripts/client-selfcheck.mjs",
    "prepack": "node scripts/client-selfcheck.mjs"
  }
}
